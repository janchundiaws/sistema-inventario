# Configuración para MySQL Local
# Copia este archivo como .env y ajusta los valores según tu configuración

# Configuración de la aplicación
NODE_ENV=development
PORT=3001

# Configuración de MySQL Local
DB_HOST=host.docker.internal
DB_PORT=3306
DB_NAME=sys_inventario
DB_USER=root
DB_PASSWORD=tu_password_mysql_local

# Configuración de JWT
JWT_SECRET=tu_jwt_secret_super_seguro_aqui

# Configuración de Swagger
SWAGGER_TITLE=Sistema de Inventario API
SWAGGER_DESCRIPTION=API para gestión de inventario con MySQL Local
SWAGGER_VERSION=1.0.0 